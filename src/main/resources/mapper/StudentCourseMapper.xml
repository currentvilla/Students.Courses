<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="StSub8.Students.Courses.Mapper.StudentCourseMapper">

  <!-- resultMap: courses + enrollment_status をJOINで1回取得 -->
  <resultMap id="courseWithStatusResultMap" type="StSub8.Students.Courses.data.StudentCourse">
    <id property="id" column="sc_id"/>
    <result property="studentId" column="student_id"/>
    <result property="courseName" column="course_name"/>
    <result property="startDate" column="start_date"/>
    <result property="expectedEndDate" column="expected_end_date"/>
    <association property="enrollmentStatus"
      javaType="StSub8.Students.Courses.data.EnrollmentStatus">
      <id property="id" column="es_id"/>
      <result property="studentCourseId" column="student_course_id"/>
      <result property="status" column="status"/>
    </association>
  </resultMap>

  <!-- 受講生コース情報の全件検索（enrollment_statusをJOINで同時取得） -->
  <select id="findAllCourses" resultMap="courseWithStatusResultMap">
    SELECT
    sc. id AS sc_id,
    sc.student_id,
    sc.course_name,
    sc.start_date,
    sc.expected_end_date,
    es. id AS es_id,
    es.student_course_id,
    es. status
    FROM students_courses sc
    LEFT JOIN enrollment_status es ON sc.id = es.student_course_id
  </select>

  <!-- コースIDによる検索 -->
  <select id="findById" parameterType="String"
    resultType="StSub8.Students.Courses.data.StudentCourse">
    SELECT * FROM students_courses WHERE id = #{id}
  </select>

  <!-- 受講生IDによる検索 -->
  <select id="findByStudentId" parameterType="String"
    resultType="StSub8.Students.Courses.data.StudentCourse">
    SELECT * FROM students_courses
    WHERE student_id = #{studentId}
    ORDER BY start_date
  </select>

  <!-- コース情報の登録 -->
  <insert id="insert" parameterType="StSub8.Students.Courses.data.StudentCourse">
    INSERT INTO students_courses
    (id, student_id, course_name, start_date, expected_end_date)
    VALUES
    (#{id}, #{studentId}, #{courseName}, #{startDate}, #{expectedEndDate})
  </insert>

  <!-- コース情報の更新 -->
  <update id="update" parameterType="StSub8.Students.Courses.data.StudentCourse">
    UPDATE students_courses
    SET course_name = #{courseName}
    WHERE id = #{id}
  </update>

  <!-- コース情報の削除 -->
  <delete id="delete" parameterType="String">
    DELETE FROM students_courses WHERE id = #{id}
  </delete>

  <!-- 受講生ごとコース情報を削除 -->
  <delete id="deleteByStudentId" parameterType="String">
    DELETE FROM students_courses WHERE student_id = #{studentId}
  </delete>

</mapper>