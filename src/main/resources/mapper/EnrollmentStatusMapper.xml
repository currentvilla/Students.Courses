<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="StSub8.Students.Courses.Mapper.EnrollmentStatusMapper">

  <select id="findAll" resultType="StSub8.Students.Courses.data.EnrollmentStatus">
    SELECT * FROM enrollment_status
  </select>

  <select id="findByStudentCourseId" resultType="StSub8.Students.Courses.data.EnrollmentStatus">
    SELECT * FROM enrollment_status
    WHERE student_course_id = #{studentCourseId}
  </select>

  <insert id="insert">
    INSERT INTO enrollment_status (id, student_course_id, status)
    VALUES (#{id}, #{studentCourseId}, #{status})
  </insert>

  <update id="update">
    UPDATE enrollment_status
    SET status = #{status}
    WHERE id = #{id}
  </update>

</mapper>